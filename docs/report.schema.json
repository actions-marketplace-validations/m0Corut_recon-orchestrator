{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "recon-orchestrator report.json",
  "type": "object",
  "required": ["target", "generated_at", "meta", "counts", "findings", "errors"],
  "properties": {
    "target": { "type": "string" },
    "generated_at": { "type": "string" },
    "lang": { "type": "string" },
    "meta": { "type": "object" },
    "counts": {
      "type": "object",
      "properties": {
        "info": { "type": "integer" },
        "low": { "type": "integer" },
        "medium": { "type": "integer" },
        "high": { "type": "integer" },
        "critical": { "type": "integer" }
      }
    },
    "diff": {
      "type": "object",
      "properties": {
        "new": { "type": "integer" },
        "resolved": { "type": "integer" },
        "unchanged": { "type": "integer" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "title", "severity", "detail", "rule_id", "fingerprint"],
        "properties": {
          "module": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "detail": { "type": "string" },
          "evidence": { "type": "string" },
          "recommendation": { "type": "string" },
          "rule_id": { "type": "string" },
          "fingerprint": { "type": "string" },
          "baseline_state": { "enum": ["new", "unchanged"] }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } },
    "suppressed": {
      "description": "Findings hidden by a suppression file (excluded from counts and gates).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "fingerprint", "reason"],
        "properties": {
          "rule_id": { "type": "string" },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "module": { "type": "string" },
          "title": { "type": "string" },
          "fingerprint": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
