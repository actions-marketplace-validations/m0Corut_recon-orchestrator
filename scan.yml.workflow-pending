name: recon-scan

# Örnek: her push'ta Docker'sız hızlı modülleri çalıştırır ve SARIF'i
# GitHub code scanning'e yükler. TARGET'ı kendi izinli sisteminle değiştir.
# Docker gerektiren modüller (ports/tls/web) için runner'da Docker gerekir;
# ubuntu-latest'te Docker vardır, istersen -m all yapabilirsin.

on:
  workflow_dispatch:
    inputs:
      target:
        description: "Taranacak hedef (yetkili olmalısın)"
        required: true

permissions:
  security-events: write   # SARIF upload için
  contents: read

jobs:
  scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - run: pip install -r requirements.txt

      - name: Run recon
        run: |
          python -m recon "${{ github.event.inputs.target }}" \
            --authorized -m headers,cors,content -o out

      - name: Locate SARIF
        id: sarif
        run: echo "path=$(find out -name findings.sarif | head -1)" >> "$GITHUB_OUTPUT"

      - name: Upload SARIF
        if: steps.sarif.outputs.path != ''
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: ${{ steps.sarif.outputs.path }}
